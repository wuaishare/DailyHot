# 站点部署路径（如 "/" 或子目录 "/dailyhot/"）
VITE_DIR=/

# 主热榜 API 地址
VITE_GLOBAL_API=https://api1.example.com

# 备用热榜 API 地址（可选）
VITE_GLOBAL_API2=https://api2.example.com

# 站点线上域名（用于 sitemap/robots/canonical）
VITE_SITE_URL=https://dailyhot.example.com

# ICP 备案号（可选）
VITE_ICP=

# 构建时是否开启预渲染（可选）
PRERENDER=false
